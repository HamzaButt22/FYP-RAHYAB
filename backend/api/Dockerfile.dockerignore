# Build context is the repository root for the API image (it needs backend/, database/ and the two
# framework files the results use).
# Everything is excluded except what the image needs.
*
!backend/api/pyproject.toml
!backend/api/uv.lock
!backend/api/alembic.ini
!backend/api/src/
!backend/api/migrations/
!backend/scoring/pyproject.toml
!backend/scoring/src/
!database/schema.sql
!design/game/frameworks/streams.json
!design/game/frameworks/scoring.json
!design/tokens/tokens.css
**/__pycache__
