*
!backend/api/pyproject.toml
!backend/api/uv.lock
!backend/api/alembic.ini
!backend/api/src/
!backend/api/migrations/
!backend/scoring/pyproject.toml
!backend/scoring/src/
!database/schema.sql
**/__pycache__
