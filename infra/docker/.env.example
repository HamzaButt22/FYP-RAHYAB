# Copy to .env and fill in. Never commit .env (it is git-ignored).
APP_ENV=development
DEBUG=true

POSTGRES_DB=rahyaab
# Admin (superuser of the container). Used only for migrations and to set the app roles' passwords.
POSTGRES_USER=rahyaab_admin
POSTGRES_PASSWORD=change-me-locally
# Least-privilege roles created by database/schema.sql. Set their passwords once with
# database/set_role_passwords.sql (see database/README.md). Locally you may point both at the admin.
API_DB_USER=api_rw
API_DB_PASSWORD=change-me-locally
JOBS_DB_USER=jobs
JOBS_DB_PASSWORD=change-me-locally

# Exact dashboard origin for CORS (no wildcard)
DASHBOARD_ORIGIN=http://localhost:5173

# Auth (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SIGNING_KEY=
ACCESS_TOKEN_MINUTES=15

# The master key for restricted columns is NOT an environment variable. It is a Docker secret file:
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())" > secrets/data_key_wrapper
# It wraps (encrypts) a random 256-bit data key per record (envelope encryption, AES-256-GCM; DATA_GOVERNANCE.md §4).
DATA_KEY_VERSION=1


# Optional services
SMS_PROVIDER_API_KEY=
SMTP_URL=
ONET_USERNAME=
ONET_PASSWORD=
GLITCHTIP_DSN=

# Release (production only)
RELEASE_TAG=
GLITCHTIP_DIGEST=
API_HOST=api.rahyaab.pk
DASHBOARD_HOST=dashboard.rahyaab.pk
API_ORIGIN=https://api.rahyaab.pk

# Backups (nightly, the backup service): put these in secrets/backup.env, NOT here:
#   PGHOST=db  PGDATABASE=rahyaab  PGUSER=<read-only backup role>  PGPASSWORD=...
#   AGE_RECIPIENT=age1...                (public key; the private key stays offline)
#   RCLONE_REMOTE=offsite:rahyaab-backups
#   RCLONE_CONFIG_OFFSITE_TYPE=s3  RCLONE_CONFIG_OFFSITE_PROVIDER=...  RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=...
#   RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=...  RCLONE_CONFIG_OFFSITE_ENDPOINT=...
