# Static file server inside the dashboard container. TLS, HSTS and the CSP are added by the edge Caddy
# (infra/docker/Caddyfile) or the Kubernetes ingress.
{
	admin off
	persist_config off
	auto_https off
}

:8080 {
	root * /srv/dashboard
	encode zstd gzip
	try_files {path} /index.html
	file_server
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
}
