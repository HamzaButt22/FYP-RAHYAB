  usecase "Record parental\nconsent" as UC02
  usecase "Play a week" as UC03
  usecase "Record and sync\ntelemetry" as UC04
  usecase "View results" as UC05
  usecase "Compute\nrecommendation" as UC06
  usecase "See routes for my\ncurrent group" as UC18
  usecase "Explore streams\nand careers" as UC07
  usecase "Share with\nparent" as UC08
  usecase "View parent\nreport" as UC09
  usecase "Reassess" as UC10
  usecase "Manage my data" as UC11
  usecase "Check in my class\nor situation" as UC17
  usecase "Use read-aloud and\naccessibility" as UC16
  usecase "Review class progress\nand flags" as UC12
  usecase "Manage schools,\ncodes, content" as UC13
  usecase "Activate a\nmodel version" as UC14
