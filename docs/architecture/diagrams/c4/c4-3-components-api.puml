@startuml c4-3-components-api
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title C4 level 3: API components (modular monolith)

Container(app, "Mobile app", "Expo")
Container(dash, "Dashboard", "React")
Person(parent, "Parent")
ContainerDb(pg, "PostgreSQL", "16")
System_Ext(sms, "SMS aggregator", "Parent OTP (individual path)")
System_Ext(mail, "Email service", "Staff invites and resets")
Container_Boundary(api, "API (FastAPI)") {
  Component(mw, "Middleware", "ASGI", "Request ID, rate limits, CORS allowlist, security headers, problem+json")
  Component(authz, "Identity and policy", "Python", "JWT and sessions, MFA, RBAC, tenant scope")
  Component(gate, "Consent gate", "Python", "Blocks uploads, results and sharing without valid consent")
  Component(rAuth, "auth router", "FastAPI", "Join, re-link, refresh, staff login, MFA, reset")
  Component(rEvents, "telemetry router", "FastAPI", "Batch validation, quarantine")
  Component(rResults, "results router", "FastAPI", "Compute, latest, why")
  Component(rLib, "library router", "FastAPI", "Streams, careers, saved")
  Component(rShare, "sharing router", "FastAPI", "Create, list and revoke links")
  Component(rMe, "profile and consent routers", "FastAPI", "/me, export, delete, consents, parent OTP")
  Component(rContent, "content router", "FastAPI", "Manifest, signed packs (HTTP Range)")
  Component(rParent, "parent views", "Jinja2", "P-01, P-02")
  Component(rDash, "dashboard router", "FastAPI", "Roster, summary, flags, notes, CSV, consent slips, re-link codes")
  Component(rAdmin, "admin and research routers", "FastAPI", "Schools, packs, models, audit, exports")
  Component(scoring, "Scoring adapter", "rahyaab_scoring", "Pipeline + model registry")
  Component(audit, "Audit logger", "Python", "Append-only access log")
  Component(repo, "Repositories", "SQLAlchemy Core", "One per module")
}
Rel(app, mw, "HTTPS /v1")
Rel(dash, mw, "HTTPS /v1")
Rel(parent, mw, "HTTPS /p")
Rel(mw, authz, "")
Rel(authz, rAuth, "")
Rel(authz, gate, "")
Rel(gate, rEvents, "")
Rel(gate, rResults, "")
Rel(gate, rShare, "")
Rel(authz, rMe, "")
Rel(authz, rContent, "")
Rel(authz, rLib, "")
Rel(mw, rParent, "")
Rel(authz, rDash, "")
Rel(authz, rAdmin, "")
Rel(rResults, scoring, "")
Rel(rDash, audit, "")
Rel(rAdmin, audit, "")
Rel(repo, pg, "SQL")
Rel(rAuth, repo, "")
Rel(rEvents, repo, "")
Rel(rResults, repo, "")
Rel(rLib, repo, "")
Rel(rShare, repo, "")
Rel(rMe, repo, "")
Rel(rContent, repo, "")
Rel(rParent, repo, "read stored result")
Rel(rDash, repo, "")
Rel(rAdmin, repo, "")
Rel(scoring, repo, "trait estimates, results")
Rel(audit, repo, "INSERT audit_log")
Rel(rMe, sms, "OTP")
Rel(rAuth, mail, "reset link (queued)")
@enduml
