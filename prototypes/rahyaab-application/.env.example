# Copy to .env (never commit .env) and restart `npx expo start`.
#
# RahYaab server (Flask API that scores the Adventure). No trailing /api.
#   Android emulator -> your laptop:   http://10.0.2.2:5000
#   Phone on the same Wi-Fi:           http://<your-laptop-LAN-IP>:5000   (development builds only)
#   Production:                        https://<your-server>              (https is required outside development)
EXPO_PUBLIC_RAHYAAB_API_URL=http://10.0.2.2:5000

# EXPO_PUBLIC_* values are compiled into the app and readable by anyone who has it: never put passwords or keys here.

# Only for a LAN demo build without HTTPS (e.g. a classroom pilot). Leave unset in production.
# EXPO_PUBLIC_RAHYAAB_ALLOW_HTTP=1
