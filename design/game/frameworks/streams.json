  "gates": [
    {
      "id": "biology_for_medicine",
      "rule": "MBBS/BDS need HSSC Pre-Medical (Biology and Chemistry, with Physics) or an IBCC-equivalent qualification. Without Biology at Matric, the routes are re-taking class 9 in a Biology group or, where the board allows, passing Biology as an additional subject (board routes are listed under routes and are unverified).",
      "applies_to": [
        "pre_medical",
        "medicine"
      ],
      "source": "PM&DC statement on the FSc (pre-medical) requirement, The Nation, 24 Oct 2026; regulations: https://pmdc.pk/Documents/law/Admissions%20Regulations-2025.pdf",
      "verification": "reported",
      "last_verified": "2026-11-11",
      "source_url": "https://www.nation.com.pk/24-Oct-2026/pmdc-clarifies-fsc-requirement-mbbs-bds-programs"
    },
    {
      "id": "mbbs_marks",
      "rule": "MBBS/BDS need at least 60% in HSSC Pre-Medical (or IBCC equivalence) and a pass in the MDCAT. The MDCAT pass mark is set by PM&DC each session and has been relaxed for vacant seats, so the app names PM&DC instead of a number.",
      "applies_to": [
        "medicine"
      ],
      "source": "PM&DC statement (The Nation, 24 Oct 2026); MDCAT relaxation: https://www.dawn.com/news/1989922",
      "verification": "reported",
      "last_verified": "2026-11-11",
      "source_url": "https://www.nation.com.pk/24-Oct-2026/pmdc-clarifies-fsc-requirement-mbbs-bds-programs"
    },
    {
      "id": "engineering_marks",
      "rule": "A bachelor's in engineering needs HSSC Pre-Engineering (Physics, Chemistry, Mathematics) with at least 60% aggregate, and the institution's entry test.",
      "applies_to": [
        "engineering"
      ],
      "source": "PEC Regulations for Engineering Education in Pakistan (Gazette 20 Nov 1985, amended to 17 Dec 2021, SRO 1606(I)/2021), admission requirements (a)(i) and (b)",
      "verification": "primary",
      "last_verified": "2026-11-11",
      "source_url": "https://www.pec.org.pk/wp-content/uploads/2022/11/REGULATIONS-FOR-ENGG-EDU.pdf"
    },
    {
      "id": "ics_to_engineering",
      "rule": "ICS (Physics, Mathematics and Computer Science) is accepted only for computer-related engineering, electronics, telecommunications and avionics engineering, not for every engineering programme.",
      "applies_to": [
        "engineering"
      ],
      "effect": "opens_some",
      "source": "PEC Regulations (amended to 17 Dec 2021), admission requirement (a)(i). Corrects v1.2.0, which said 'all engineering programmes' from a news site",
      "verification": "primary",
      "last_verified": "2026-11-11",
      "source_url": "https://www.pec.org.pk/wp-content/uploads/2022/11/REGULATIONS-FOR-ENGG-EDU.pdf"
    },
    {
      "id": "premed_to_engineering",
      "rule": "Pre-Medical students may be admitted to engineering after an eight-week condensed course in the missing subjects (such as mathematics) and the university's entry test, with at least 60% in HSSC; up to 40% of each programme's seats.",
      "applies_to": [
        "engineering"
      ],
      "effect": "opens_with_condition",
      "source": "PEC Governing Body, 49th meeting (28 Jun 2024), letter to HEC of 11 Jul 2024, as reported by ProPakistani. Corrects v1.2.0 ('with Additional Mathematics')",
      "verification": "reported",
      "last_verified": "2026-11-11",
      "source_url": "https://propakistani.pk/2024/07/15/pre-medical-students-can-now-enroll-in-engineering-degrees/"
    },
    {
      "id": "a_level_equivalence",
      "rule": "A Level students need IBCC equivalence certificates (O Level and A Level) before applying; medical routes need Biology. The equivalent percentage is computed by IBCC's formula.",
      "applies_to": [
        "medicine"
      ],
      "source": "IBCC formula and thresholds not yet confirmed from ibcc.edu.pk; v1.2.0 cited a college page (RMI)",
      "verification": "unverified",
      "last_verified": "2026-11-11",
      "source_url": null
    },
    {
      "id": "dae_to_engineering",
      "rule": "A DAE holder with at least 60% may apply for engineering in the same discipline as the diploma, against 2% reserved seats.",
      "applies_to": [
        "engineering",
        "dae"
      ],
      "effect": "opens_with_condition",
      "verification": "primary",
      "last_verified": "2026-11-11",
      "source_url": "https://www.pec.org.pk/wp-content/uploads/2022/11/REGULATIONS-FOR-ENGG-EDU.pdf",
      "source": "PEC Regulations (amended to 17 Dec 2021), admission requirement (c)(i)"
    }
  ],
