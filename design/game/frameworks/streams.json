  "verification_policy": {
    "levels": {
      "primary": "Read in the official document itself (regulation, gazette, board notification).",
      "reported": "An official decision or statement, reported by a named reputable outlet; the primary document was not retrieved.",
      "unverified": "No official source yet. The app must not state it as a rule; it shows 'Check this with your school or board' instead."
    },
    "rules": [
      "Every gate and route has verification, last_verified and, unless unverified, source_url.",
      "Numbers that change every session (MDCAT pass marks, merit cut-offs) are never hard-coded; the app says who sets them.",
      "Re-check every gate before each school year and before the pilot (tools/check_streams.py fails CI on a missing field).",
      "Board rules are per board and per session: each entry names the boards it covers (applies_to_boards) and, when dated, the session. A province with several boards is not verified by one board's rule."
    ]
  }
